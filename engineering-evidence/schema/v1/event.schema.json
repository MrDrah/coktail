{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app-boilerplate:engineering-evidence:event:1",
  "title": "Engineering event — one line of docs/evidence/events.jsonl",
  "description": "Append-only development log. Written by 'evidence.mjs event' and automatically by 'validate.mjs task-start' / 'diff-guard'. Summaries are short and public-safe: no secrets, emails, private prompts or local paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "at", "type", "summary"],
  "properties": {
    "v": { "const": 1 },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "type": {
      "enum": [
        "product-decision", "approval", "technical-correction", "agent-failure", "manual-implementation",
        "task-start", "task-end", "interruption", "resume", "recovery-test", "defect", "verification", "milestone"
      ]
    },
    "summary": { "type": "string", "minLength": 3, "maxLength": 200 },
    "by": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Role, not a person: product-owner, orchestrator, ba, designer, developer, qa, verifier, metrics, ci." },
    "task": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "milestone": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "outcome": { "enum": ["success", "failure"], "description": "task-end, resume, recovery-test, verification" },
    "defect": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "severity": { "enum": ["P1", "P2", "P3", "P4"] },
    "state": { "enum": ["found", "fixed", "deferred"] },
    "regression": { "type": "boolean" },
    "minutes": { "type": "number", "minimum": 0, "description": "Rework or lost progress, for interruption/resume events." }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "defect" } } }, "then": { "required": ["defect", "severity", "state"] } },
    { "if": { "properties": { "type": { "enum": ["task-start", "task-end"] } } }, "then": { "required": ["task"] } },
    { "if": { "properties": { "type": { "enum": ["task-end", "resume", "recovery-test", "verification"] } } }, "then": { "required": ["outcome"] } }
  ]
}
