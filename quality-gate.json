{
  "$comment": "app-boilerplate quality gate config for Cocktail Cabinet. Used by .claude/skills/quality-gate/scripts/validate.mjs, the guard hook and CI.",
  "commands": [
    { "name": "validate data", "run": "npm run validate:data" },
    { "name": "typecheck", "run": "npm run typecheck" },
    { "name": "unit + coverage", "run": "npm run coverage" },
    { "name": "build", "run": "npm run build" }
  ],
  "generated": [
    { "path": "data/cocktails.json", "from": "data/_research/batch-*.json", "by": "npm run merge:research" },
    { "path": "tests/library/verification-matrix.csv", "from": "the library verification test", "by": "WRITE_MATRIX=1 npm run test:library" },
    { "path": "dist/**", "by": "npm run build" }
  ],
  "docs": {
    "required": ["CATCH-UP.md", "docs/00-orchestration-plan.md", "docs/ba/user-stories.md", "docs/ba/research-brief.md", "tests/reports/mvp-test-report.md"],
    "catchUp": "CATCH-UP.md",
    "maxStaleDays": 7,
    "decisionLog": { "file": "docs/00-orchestration-plan.md", "heading": "Decision" }
  },
  "trace": {
    "stories": "docs/ba/user-stories.md",
    "tests": ["tests/**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}"],
    "pattern": "US-[A-Z0-9]+-\\d+",
    "allowUntested": []
  },
  "stages": {
    "dev": ["preflight", "secrets", "commands", "budget"],
    "release": ["preflight", "docs", "trace", "secrets", "commands", "budget"]
  },
  "budgets": [
    { "name": "JS bundle", "glob": "dist/assets/*.js", "maxGzipKb": 400 },
    { "name": "CSS", "glob": "dist/assets/*.css", "maxGzipKb": 50 }
  ],
  "secrets": { "exclude": ["package-lock.json", "data/**", "docs/cocktail-list.txt"] },
  "overlap": {
    "records": ["data/_research/batch-*.json"],
    "idField": "id",
    "fields": ["shortDescription", "history", "tasteProfile"],
    "sourcesField": "sources",
    "urlField": "url",
    "cacheDir": ".cache/sources",
    "minRun": 7,
    "failAt": 12,
    "acceptFile": "data/_research/overlap-accepted.json",
    "delayMs": 3000
  },
  "preflight": { "nodeMajor": 20, "requireRemote": true, "optional": ["gh", "playwright"] }
}
