# Every environment variable the app reads, with a comment and NO real value.
# Copy to .env (git-ignored) for local development. CI and production values live in the
# CI provider's secret store and are set by the product owner.

# --- MVP (static) ---
# Public base path when hosted under a sub-folder, e.g. GitHub Pages project sites.
VITE_BASE_PATH=/

# --- v1: accounts (see templates/v1/AUTH_AND_ACCOUNTS.md) ---
# VITE_AUTH_URL=            # public auth endpoint of the provider
# VITE_AUTH_PUBLIC_KEY=     # publishable/anon key only; never a service/secret key here
# AUTH_SECRET_KEY=          # server-only

# --- v1: database (see templates/v1/DATA_MODEL.md) ---
# DATABASE_URL=             # server-only, one per environment

# --- v1: external APIs (see templates/v1/API_CONTRACT.md) ---
# EXAMPLE_API_BASE_URL=
# EXAMPLE_API_KEY=          # server-only unless the vendor designs it to be public
